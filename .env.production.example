# Production environment (branch main, shirobell.my.id) for the Docker deploy.
# Copy to /opt/shirobell/.env on the server and fill in the blanks.
# Staging uses .env.staging.example. Never commit the real files.

# --- Compose (read by docker-compose.prod.yml) ---
STACK_NAME=shirobell
GHCR_OWNER=yobel47
# Network of Nginx Proxy Manager (npm-app-1).
PROXY_NETWORK=proxy-net
# Dedicated network shared with the MySQL container (docker network connect).
DB_NETWORK=shirobell-db
# Memory caps per container (shared VPS). Staging can be smaller.
APP_MEM=320m
WORKER_MEM=192m
SCHEDULER_MEM=128m
WEB_MEM=48m

# --- Application ---
APP_NAME=Shirobell
APP_ENV=production
# Generate on the server: echo "base64:$(openssl rand -base64 32)"  (one per environment)
APP_KEY=
APP_DEBUG=false
APP_URL=https://shirobell.my.id
APP_DOMAIN=shirobell.my.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Docker networks (NPM) plus Cloudflare edge ranges (https://www.cloudflare.com/ips/).
# Never "*": a forged X-Forwarded-For would then bypass per-IP rate limits.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (existing MySQL) ---
DB_CONNECTION=mysql
# Container name of MySQL on DB_NETWORK.
DB_HOST=vps-mysql
DB_PORT=3306
DB_DATABASE=shirobell
DB_USERNAME=shirobell
DB_PASSWORD=

# --- Session, cache, queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (Brevo) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@shirobell.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Midtrans (sandbox first, production after approval) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=

# --- Security ---
SECURITY_CSP_ENABLED=true

# --- Initial admin (read once by AdminSeeder) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
