# Staging environment (branch dev, dev.shirobell.my.id) for the Docker deploy.
# Copy to /opt/shirobell-dev/.env on the server and fill in the blanks.
# Use its own database and APP_KEY; never reuse production secrets here.

# --- Compose (read by docker-compose.prod.yml) ---
STACK_NAME=shirobell-dev
GHCR_OWNER=yobel47
# Network of Nginx Proxy Manager (npm-app-1).
PROXY_NETWORK=proxy-net
# Dedicated network shared with the MySQL container (docker network connect).
DB_NETWORK=shirobell-db
# Memory caps per container (shared VPS). Staging can be smaller.
APP_MEM=256m
WORKER_MEM=160m
SCHEDULER_MEM=128m
WEB_MEM=48m

# --- Application ---
APP_NAME="Shirobell Dev"
APP_ENV=staging
# Generate on the server: echo "base64:$(openssl rand -base64 32)"  (one per environment)
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev.shirobell.my.id
APP_DOMAIN=dev.shirobell.my.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Staging is not behind Cloudflare: trust only the Docker networks (NPM).
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database (existing MySQL) ---
DB_CONNECTION=mysql
# Container name of MySQL on DB_NETWORK.
DB_HOST=vps-mysql
DB_PORT=3306
DB_DATABASE=shirobell_dev
DB_USERNAME=shirobell_dev
DB_PASSWORD=

# --- Session, cache, queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (Brevo) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@shirobell.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Midtrans (staging always uses sandbox) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=

# --- Security ---
SECURITY_CSP_ENABLED=true

# --- Initial admin (read once by AdminSeeder) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
