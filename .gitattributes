* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Files used inside Linux containers must keep LF line endings.
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
